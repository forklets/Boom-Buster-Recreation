function col_to_str(arg0)
{
    switch (arg0)
    {
        case 0:
            return "orange";
            break;
        
        case 1:
            return "cyan";
            break;
        
        case 2:
            return "purple";
            break;
        
        case 3:
            return "lime";
            break;
        
        case 4:
            return "yellow";
            break;
        
        case 20:
            return "barrel";
            break;
    }
}
